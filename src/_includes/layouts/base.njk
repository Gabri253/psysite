  <main class="block w-full font-sans bg-brand-beige">
    <a href="https://wa.me/{{ site.phone }}" class="fixed bottom-8 right-4 bg-brand-light-beige p-2 rounded-full shadow-lg hover:scale-110 transition-transform z-50"><img src="/assets/img/whatsapp.webp" alt="WhatsApp Logo" class=" h-10 md:h-16" loading="lazy"></a>
