<header class="bg-brand-beige pt-3 md:pt-6 relative z-50" x-data="{ mobileMenuOpen: false }"
  x-init="$watch('mobileMenuOpen', value => {document.body.style.overflow = value ? 'hidden' : '';})">
  <div class="mx-auto max-w-7xl px-2 sm:px-6 lg:px-8 pb-4 md:pb-6">
    <div class="flex h-16 items-center justify-between">
      <div class="md:flex md:items-center md:gap-12">
        <a class="block" href="/">
          <img src="/assets/img/logoSaraMartiniS.webp" alt="Logo" class="h-20 md:h-28 w-auto object-contain" loading="lazy">
        </a>
      </div>
      <nav class="hidden md:block" aria-label="Global">
        <ul class="flex items-center gap-6 text-brand-forest font-serif">
          <li><a href="/" class="hover:text-brand-forest font-semibold md:text-xl lg:text-2xl transition-colors">Home</a></li>
          <li><a href="/chi-sono/" class="hover:text-brand-forest font-semibold md:text-xl lg:text-2xl transition-colors">Chi sono</a></li>
          <li><a href="/servizi/" class="hover:text-brand-forest font-semibold md:text-xl lg:text-2xl transition-colors">Servizi</a></li>
          <li><a href="/blog/" class="hover:text-brand-forest font-semibold md:text-xl lg:text-2xl transition-colors">Blog</a></li>
          <li><a href="/contatti/" class="hover:text-brand-forest font-semibold md:text-xl lg:text-2xl transition-colors">Contatti</a></li>
        </ul>
      </nav>
      <div class="flex items-center gap-2 sm:gap-4">
        <a class="rounded-md bg-brand-sage px-3 py-2 text-xs sm:px-5 sm:py-2.5 sm:text-sm font-medium text-white shadow-sm whitespace-nowrap" href="/contatti/">
          Prenota ora
        </a>
        <button @click="mobileMenuOpen = !mobileMenuOpen" class="md:hidden rounded-sm bg-gray-100 p-2 text-gray-600 transition"
          aria-label="Menu">
          <svg x-show="!mobileMenuOpen" xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg x-show="mobileMenuOpen" xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" x-cloak>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>
  <div 
    x-show="mobileMenuOpen" 
    x-transition:enter="transition cubic-bezier(0.4, 0, 0.2, 1) duration-500"
    x-transition:enter-start="opacity-0 -translate-y-4"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-300"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="absolute top-full left-0 w-full bg-brand-beige shadow-xl z-50 md:hidden border-t border-brand-forest/5"
    @click.away="mobileMenuOpen = false"
    x-cloak
  >
    <nav class="px-8 py-10 flex flex-col gap-5">
      <a href="/" 
         x-show="mobileMenuOpen" 
         x-transition:enter="transition transform duration-500 delay-[100ms]"
         x-transition:enter-start="opacity-0 translate-x-4"
         x-transition:enter-end="opacity-100 translate-x-0"
         class="text-xl font-serif text-brand-forest">Home</a>
         
      <a href="/chi-sono/" 
         x-show="mobileMenuOpen" 
         x-transition:enter="transition transform duration-500 delay-[200ms]"
         x-transition:enter-start="opacity-0 translate-x-4"
         x-transition:enter-end="opacity-100 translate-x-0"
         class="text-xl font-serif text-brand-forest">Chi sono</a>
         
      <a href="/servizi/" 
         x-show="mobileMenuOpen" 
         x-transition:enter="transition transform duration-500 delay-[300ms]"
         x-transition:enter-start="opacity-0 translate-x-4"
         x-transition:enter-end="opacity-100 translate-x-0"
         class="text-xl font-serif text-brand-forest">Servizi</a>
         
      <a href="/blog/" 
         x-show="mobileMenuOpen" 
         x-transition:enter="transition transform duration-500 delay-[400ms]"
         x-transition:enter-start="opacity-0 translate-x-4"
         x-transition:enter-end="opacity-100 translate-x-0"
         class="text-xl font-serif text-brand-forest">Blog</a>
         
      <a href="/contatti/" 
         x-show="mobileMenuOpen" 
         x-transition:enter="transition transform duration-500 delay-[500ms]"
         x-transition:enter-start="opacity-0 translate-x-4"
         x-transition:enter-end="opacity-100 translate-x-0"
         class="text-xl font-serif text-brand-forest">Contatti</a>
    </nav>
  </div>
</header>