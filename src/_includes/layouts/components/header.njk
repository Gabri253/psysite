<header class="bg-[#FDFCF5] border-b border-brand-forest/5 sticky top-0 z-50" 
  x-data="{ mobileMenuOpen: false }"
  x-init="$watch('mobileMenuOpen', value => { document.body.style.overflow = value ? 'hidden' : ''; })">
  
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-20 md:h-24 items-center justify-between py-2">
      
      <div class="flex-shrink-0">
        <a class="block" href="/">
          <img src="/assets/img/logoSaraMartiniS.webp" alt="Logo Sara Martini" class="h-16 md:h-24 w-auto object-contain">
        </a>
      </div>

      <div class="hidden md:flex items-center gap-10">
        <nav aria-label="Global">
          <ul class="flex items-center gap-8 text-[18px] uppercase tracking-[0.18em] text-brand-forest/75 font-serif">
            <li><a href="/" class="hover:text-brand-sage transition-colors font-medium">Home</a></li>
            <li><a href="/chi-sono/" class="hover:text-brand-sage transition-colors font-medium">Chi sono</a></li>
            <li><a href="/servizi/" class="hover:text-brand-sage transition-colors font-medium">Servizi</a></li>
            <li><a href="/blog/" class="hover:text-brand-sage transition-colors font-medium">Blog</a></li>
            <li><a href="/contatti/" class="hover:text-brand-sage transition-colors font-medium">Contatti</a></li>
          </ul>
        </nav>

        <a class="rounded-full bg-brand-sage px-6 py-2.5 text-[14px] tracking-[0.12em] uppercase font-semibold text-white hover:bg-brand-forest hover:scale-105 transition-all duration-300 shadow-md" href="/contatti/">
          Prenota ora
        </a>
      </div>

      <div class="flex items-center gap-3 md:hidden">
        <a class="rounded-full bg-brand-sage px-4 py-2 text-[12px] tracking-[0.1em] uppercase font-semibold text-white shadow-sm" href="/contatti/">
          Prenota
        </a>
        <button @click="mobileMenuOpen = !mobileMenuOpen" class="rounded-md p-2 text-brand-forest/80" aria-label="Apri menu">
          <svg x-show="!mobileMenuOpen" xmlns="http://www.w3.org/2000/svg" class="size-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg x-show="mobileMenuOpen" xmlns="http://www.w3.org/2000/svg" class="size-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" x-cloak>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div 
    x-show="mobileMenuOpen" 
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-200"
    class="fixed inset-0 z-[60] bg-[#FDFCF5] md:hidden overflow-y-auto"
    x-cloak
  >
    <nav class="flex flex-col w-full min-h-full">
      <div class="flex h-20 items-center justify-between px-4 border-b border-brand-forest/5">
         <img src="/assets/img/logoSaraMartiniS.webp" alt="Logo" class="h-16 w-auto">
         <button @click="mobileMenuOpen = false" class="p-2 text-brand-forest/80">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
         </button>
      </div>

      <a href="/" 
         x-show="mobileMenuOpen"
         x-transition:enter="transition transform duration-500 delay-[100ms]"
         x-transition:enter-start="opacity-0 translate-x-4"
         x-transition:enter-end="opacity-100 translate-x-0"
         class="px-8 py-6 border-b border-brand-forest/10 flex justify-between items-center text-l font-serif text-brand-forest uppercase tracking-[0.18em]">
        Home
        <span class="opacity-30">→</span>
      </a>
         
      <a href="/chi-sono/" 
         x-show="mobileMenuOpen"
         x-transition:enter="transition transform duration-500 delay-[200ms]"
         x-transition:enter-start="opacity-0 translate-x-4"
         x-transition:enter-end="opacity-100 translate-x-0"
         class="px-8 py-5 border-b border-brand-forest/10 flex justify-between items-center text-l font-serif text-brand-forest uppercase tracking-[0.18em]">
        Chi sono
        <span class="opacity-30">→</span>
      </a>
         
      <a href="/servizi/" 
         x-show="mobileMenuOpen"
         x-transition:enter="transition transform duration-500 delay-[300ms]"
         x-transition:enter-start="opacity-0 translate-x-4"
         x-transition:enter-end="opacity-100 translate-x-0"
         class="px-8 py-5 border-b border-brand-forest/10 flex justify-between items-center text-l font-serif text-brand-forest uppercase tracking-[0.18em]">
        Servizi
        <span class="opacity-30">→</span>
      </a>
         
      <a href="/blog/" 
         x-show="mobileMenuOpen"
         x-transition:enter="transition transform duration-500 delay-[400ms]"
         x-transition:enter-start="opacity-0 translate-x-4"
         x-transition:enter-end="opacity-100 translate-x-0"
         class="px-8 py-5 border-b border-brand-forest/10 flex justify-between items-center text-l font-serif text-brand-forest uppercase tracking-[0.18em]">
        Blog
        <span class="opacity-30">→</span>
      </a>
         
      <a href="/contatti/" 
         x-show="mobileMenuOpen"
         x-transition:enter="transition transform duration-500 delay-[500ms]"
         x-transition:enter-start="opacity-0 translate-x-4"
         x-transition:enter-end="opacity-100 translate-x-0"
         class="px-8 py-5 border-b border-brand-forest/10 flex justify-between items-center text-l font-serif text-brand-forest uppercase tracking-[0.18em]">
        Contatti
        <span class="opacity-30">→</span>
      </a>

      <div class="px-8 py-10 mt-auto">
        <a href="/contatti/" class="block w-full text-center rounded-md tracking-[0.1em] bg-brand-sage py-4 text-white font-bold shadow-md">
          Prenota un appuntamento
        </a>
      </div>
    </nav>
  </div>
</header>