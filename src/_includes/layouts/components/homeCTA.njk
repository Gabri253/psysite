<!-- CTA Section — sfondo brand-forest -->
<section class="bg-brand-forest/85 relative overflow-hidden py-24 px-6 sm:px-12">

  <!-- Texture decorativa: cerchi sfumati sottili -->
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute -top-32 -left-32 w-[480px] h-[480px] rounded-full
                bg-[radial-gradient(circle,rgba(91,123,95,0.18)_0%,transparent_70%)]"></div>
    <div class="absolute -bottom-24 -right-24 w-[400px] h-[400px] rounded-full
                bg-[radial-gradient(circle,rgba(91,123,95,0.13)_0%,transparent_70%)]"></div>
    <!-- Linee orizzontali decorative -->
    <div class="absolute top-10 left-0 right-0 h-px
                bg-gradient-to-r from-transparent via-brand-beige/[0.08] to-transparent"></div>
    <div class="absolute bottom-10 left-0 right-0 h-px
                bg-gradient-to-r from-transparent via-brand-beige/[0.08] to-transparent"></div>
  </div>

  <div class="relative max-w-3xl mx-auto text-center">

    <!-- Etichetta soprattitolo -->
    <p class="font-sans text-label md:text-label-md tracking-widest uppercase text-brand-beige/50 mb-6">
      Inizia oggi
    </p>

    <div class="w-48 h-px bg-brand-beige/50 opacity-60 mx-auto"></div>

    <!-- Titolo principale -->
    <h2 class="font-serif text-heading-1 sm:text-heading-1-lg xl:text-heading-1-xl text-brand-beige leading-tight my-6">
      Pronto a fare il passo<br>
      <em class="not-italic text-[#A8C5AB]">che cambia tutto?</em>
    </h2>

    <!-- Descrizione -->
    <p class="font-sans text-body text-brand-beige/50 max-w-xl mx-auto mb-10 leading-relaxed">
      Unisciti a chi ha già scelto un approccio diverso. Nessun impegno iniziale — solo un primo passo verso qualcosa di meglio.
    </p>

    <!-- Bottoni -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">

      <!-- Bottone primario -->
      <a href="#"
         class="group relative inline-flex items-center gap-2 bg-brand-beige text-brand-forest font-sans text-label-md font-semibold tracking-wide px-8 py-4 rounded-full transition-all duration-300 hover:bg-white hover:shadow-lg hover:shadow-black/20 hover:-translate-y-0.5">
        Comincia ora
        <!-- Freccia animata -->
        <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
             fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>

      <!-- Bottone secondario ghost -->
      <a href="#"
         class="group inline-flex items-center gap-2 border border-brand-sage/50 text-brand-beige/80 font-sans text-label-md font-medium tracking-wide px-8 py-4 rounded-full transition-all duration-300 hover:border-brand-beige/70 hover:text-brand-beige hover:bg-white/5">
        Scopri di più
      </a>
    </div>

    <!-- Nota di rassicurazione -->
    <p class="mt-8 font-sans text-caption text-brand-sage/70 tracking-wide">
      Nessuna carta di credito richiesta &nbsp;·&nbsp; Risposta in 24 ore
    </p>

  </div>
</section>
