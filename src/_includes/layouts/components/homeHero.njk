<section id="homeHero" class="w-full bg-brand-beige realtive overflow-hidden">
  <div class="grid grid-cols-1 lg:grid-cols-[4fr_4fr] min-h-[75vh]">

    {# Testo — colonna sinistra #}
    <div class="relative flex flex-col justify-center px-8 md:px-14 lg:px-16 xl:px-20 py-8 md:py-16 gap-6 overflow-hidden">

      {# SVG linee curve organiche — coprono tutta l'altezza della colonna #}
      <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 600 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        {# Curva principale — attraversa la colonna in diagonale morbida #}
        <path d="M 480 -20 C 420 150, 520 300, 440 480 C 360 660, 480 750, 400 920" fill="none" stroke="#5B7B5F" stroke-width="1.8" opacity="0.28"/>
        {# Curva secondaria — parallela ma sfasata #}
        <path d="M 540 -20 C 480 180, 580 340, 500 520 C 420 700, 540 800, 460 940" fill="none" stroke="#5B7B5F" stroke-width="1" opacity="0.18"/>
        {# Curva terza — più a sinistra, più corta #}
        <path d="M 350 -20 C 300 120, 400 260, 320 420 C 240 580, 360 680, 280 860" fill="none" stroke="#5B7B5F" stroke-width="0.7" opacity="0.12"/>
      </svg>

      <span class="text-body xl:text-body-xl tracking-[0.12em] uppercase text-brand-sage font-sans">
        Psicologa · Lucca
      </span>

      <div class="w-48 h-px bg-brand-sage opacity-60"></div>

      <h1 class="font-serif text-display md:text-display-md lg:text-display-lg xl:text-display-xl font-normal text-brand-forest">
        Uno spazio sicuro<br>
        per <em class="italic text-brand-sage">ritrovare</em><br>
        il tuo equilibrio.
      </h1>

      <p class="font-sans text-body xl:text-body-xl leading-relaxed text-brand-forest/70 max-w-md">
        Percorsi di psicoterapia individuale e supporto alla genitorialità.
        In studio a Lucca e online.
      </p>

      <div class="flex flex-wrap items-center gap-5 pt-2">
        <a
          href="/contatti/"
          class="inline-block bg-brand-sage text-brand-beige font-sans text-label md:text-label-md px-6 py-3 rounded-full hover:bg-brand-forest hover:scale-105 transition-all duration-300 shadow-md"
        >
          Prenota un appuntamento
        </a>
        <a
          href="/servizi/"
          class="font-sans text-label md:text-label-md  text-brand-sage border-b border-brand-sage/50 pb-px transition-colors duration-300 hover:text-brand-forest hover:border-brand-forest/50"
        >
          Scopri i servizi
        </a>
      </div>

    </div>

    {# Foto — colonna destra, taglia fino al bordo #}
    <div class="relative overflow-hidden min-h-[360px] lg:min-h-0">
      <img
        src="/assets/img/studio-template.webp"
        alt="Studio della dottoressa Sara Martini a Lucca"
        class="absolute inset-0 w-full h-full object-cover object-center"
        fetchpriority="high"
        decoding="async"
      >
      {# Sfumatura sx per raccordare col testo su schermi grandi #}
      <div class="hidden lg:block absolute inset-y-0 left-0 w-16 bg-gradient-to-r from-brand-beige to-transparent"></div>
    </div>

  </div>

  <div class="-mb-1 left-0 w-full overflow-hidden leading-none">
    <svg viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,0 C240,70 480,70 720,30 C960,0 1200,70 1440,0 L1440,80 L0,80 Z" fill="#F2F0E4"/>
    </svg>
  </div>
</section>