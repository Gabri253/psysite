<div class="p-4 md:w-1/3">
  <div class="flex flex-col h-full border border-brand-beige-dark/50 rounded-xl overflow-hidden bg-brand-light-beige shadow-sm transition-all duration-300 hover:shadow-lg hover:-translate-y-1 group">
    <div class="aspect-[4/3] overflow-hidden">
      <img
        class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
        src="{{ card.imgUrl }}"
        alt="{{ card.imgAlt }}"
        loading="lazy"
      >
    </div>
    <div class="p-6 pt-5 flex flex-col h-full">
      <h2 class="title-font font-semibold text-lg text-brand-forest mb-2">{{ card.titolo }}</h2>
      <p class="leading-relaxed text-gray-600 mb-4">{{ card.descrizione }}</p>
      <div class="mt-auto pt-4 border-t border-brand-beige-dark/40">
        <a class="text-brand-sage hover:text-brand-forest font-semibold inline-flex items-center gap-2 transition-colors duration-200">
          Scopri di più
          <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"></path>
            <path d="M12 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>

  </div>
</div>