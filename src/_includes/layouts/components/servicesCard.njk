<div class="p-4 md:w-1/2 lg:w-1/3">
  <div class="flex flex-col h-full bg-brand-beige-dark/70 rounded-2xl px-7 py-8 transition-all duration-300 hover:shadow-md hover:-translate-y-1 group">

    {# Icona #}
    <div class="mb-6">
      <div class="w-12 h-12 rounded-xl bg-brand-beige-dark flex items-center justify-center text-brand-sage transition-colors duration-300 group-hover:bg-brand-sage group-hover:text-brand-beige">
        {{ card.icona | safe }}
      </div>
    </div>

    {# Testo #}
    <h2 class="font-serif text-heading-2-md lg:text-heading-2-lg xl:text-heading-2-xl font-normal text-brand-forest mb-3">
      {{ card.titolo }}
    </h2>
    <p class="font-sans text-body xl:text-body-xl leading-relaxed text-brand-forest/65 mb-6">
      {{ card.descrizione }}
    </p>

    {# CTA #}
    <div class="mt-auto pt-5 border-t border-brand-beige-dark">
      <a href="{{ card.url }}" class="text-brand-sage hover:text-brand-forest font-sans text-body xl:text-body-xl font-medium inline-flex items-center gap-2 transition-all duration-200">
        Scopri di più
        <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="M12 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>

  </div>
</div>